{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Transcribe Doc",
  "version": "0.1.0",
  "identifier": "local.transcribe-doc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Transcribe Doc",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": [
      "binaries/transcribe-doc-backend",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "resources/configs",
      "resources/python"
    ]
  }
}
