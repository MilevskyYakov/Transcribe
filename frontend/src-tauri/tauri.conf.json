{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Transcribe Doc",
  "version": "0.1.0",
  "identifier": "local.transcribe-doc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Transcribe Doc",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/transcribe-doc-backend",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "resources/configs",
      "resources/python"
    ],
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxQjkxQTM1ODlFQzY2MzEKUldReFp1eUpOUnE1d2J3a3BqNEhXclFlOVFWcmtGTUNYYUozdzZpRURYVlVYd0tIamY0SVFsMDQK",
      "endpoints": [
        "https://github.com/kairosUNIVERSAL/Transcribe/releases/latest/download/latest.json"
      ]
    }
  }
}
