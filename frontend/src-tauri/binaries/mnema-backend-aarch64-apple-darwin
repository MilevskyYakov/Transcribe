#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BUNDLE_RESOURCE_DIR="$SCRIPT_DIR/../Resources"
RESOURCE_DIR="$BUNDLE_RESOURCE_DIR/resources"
REPO_ROOT=""

if [ ! -d "$RESOURCE_DIR/python" ]; then
  REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd || true)"
  RESOURCE_DIR="$REPO_ROOT/frontend/src-tauri/resources"
fi

PYVENV_CFG="$RESOURCE_DIR/python/pyvenv.cfg"
SITE_PACKAGES=""
BASE_PYTHON=""

if [ -f "$PYVENV_CFG" ]; then
  SITE_PACKAGES="$(find "$RESOURCE_DIR/python/lib" -maxdepth 3 -type d -name site-packages -print -quit 2>/dev/null || true)"
  BASE_PYTHON="$(awk -F' = ' '/^executable = / { print $2; exit }' "$PYVENV_CFG" 2>/dev/null || true)"
  if [ ! -x "$BASE_PYTHON" ]; then
    PYTHON_HOME="$(awk -F' = ' '/^home = / { print $2; exit }' "$PYVENV_CFG" 2>/dev/null || true)"
    if [ -n "$PYTHON_HOME" ] && [ -x "$PYTHON_HOME/python3.11" ]; then
      BASE_PYTHON="$PYTHON_HOME/python3.11"
    fi
  fi
fi

if [ -n "$BASE_PYTHON" ] && [ -x "$BASE_PYTHON" ] && [ -n "$SITE_PACKAGES" ]; then
  PYTHON="$BASE_PYTHON"
elif [ -x "$RESOURCE_DIR/python/bin/python" ]; then
  PYTHON="$RESOURCE_DIR/python/bin/python"
elif [ -n "$REPO_ROOT" ] && [ -x "$REPO_ROOT/.venv/bin/python" ]; then
  PYTHON="$REPO_ROOT/.venv/bin/python"
else
  echo "Mnema backend error: Python runtime was not found in $RESOURCE_DIR/python" >&2
  PYTHON="python3"
fi

if [ -n "$REPO_ROOT" ] && [ -d "$REPO_ROOT/src" ]; then
  export PYTHONPATH="$REPO_ROOT/src:${PYTHONPATH:-}"
fi

export PATH="$SCRIPT_DIR:$RESOURCE_DIR/bin:${PATH:-}"
export PYTHONUNBUFFERED=1
if [ -n "$SITE_PACKAGES" ] && [ "$PYTHON" = "$BASE_PYTHON" ]; then
  unset PYTHONPATH
  exec "$PYTHON" - "$SITE_PACKAGES" "$@" <<'PY'
import runpy
import site
import sys

site.addsitedir(sys.argv[1])
sys.argv = ["mnema.cli.main", *sys.argv[2:]]
runpy.run_module("mnema.cli.main", run_name="__main__")
PY
else
  exec "$PYTHON" -m mnema.cli.main "$@"
fi
